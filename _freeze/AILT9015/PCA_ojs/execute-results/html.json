    "markdown": "---\ntitle: \"PCA & Batch Effect Explorer\"\nauthor: \"Biomedical Data Science\"\nformat: dashboard\n---\n\n\n\n## {.sidebar}\n\n```{.ojs}\n//| panel: sidebar\nviewof selectedScenario = Inputs.radio(\n  new Map([\n    [\"Normal (Clean Data)\", \"normal\"],\n    [\"Batch Effect (Large Technical Var)\", \"batch_effect\"],\n    [\"Selection Bias (Confounded)\", \"selection_bias\"]\n  ]), \n  { label: \"Select Scenario:\", value: \"batch_effect\" }\n)\n\nviewof colorBy = Inputs.select(\n  [\"Condition\", \"Batch\"], \n  { label: \"Color points by:\", value: \"Condition\" }\n)\n```\n\n:::\n\n## Column\n\n## Row\n\n```{ojs}\n// Convert the R data frame transpose structure to OJS-friendly array of objects\ndata = transpose(combined_data)\n\n// Filter data on the client side based on the sidebar selection\nfilteredData = data.filter(d => d.Scenario === selectedScenario)\n\n// Get variance labels dynamically from the filtered rows\npc1_label = filteredData[0] ? filteredData[0].PC1_var : \"\"\npc2_label = filteredData[0] ? filteredData[0].PC2_var : \"\"\n\n// Render the interactive plot using Observable Plot\nPlot.plot({\n  grid: true,\n  x: { label: `PC1 (${pc1_label}% Variance)` },\n  y: { label: `PC2 (${pc2_label}% Variance)` },\n  color: { legend: true },\n  marks: [\n    Plot.dot(filteredData, {\n      x: \"PC1\",\n      y: \"PC2\",\n      fill: colorBy,\n      stroke: \"white\",\n      r: 6,\n      channels: { Sample: \"SampleID\", Batch: \"Batch\", Condition: \"Condition\" },\n      tip: true // Built-in client-side interactive tooltips!\n    })\n  ]\n})\n```\n\n",
