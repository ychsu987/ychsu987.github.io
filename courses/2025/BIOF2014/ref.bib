@incollection{TACQ2010332,
title = {Multivariate Normal Distribution},
editor = {Penelope Peterson and Eva Baker and Barry McGaw},
booktitle = {International Encyclopedia of Education (Third Edition)},
publisher = {Elsevier},
edition = {Third Edition},
address = {Oxford},
pages = {332-338},
year = {2010},
isbn = {978-0-08-044894-7},
doi = {https://doi.org/10.1016/B978-0-08-044894-7.01351-8},
url = {https://www.sciencedirect.com/science/article/pii/B9780080448947013518},
author = {J. Tacq},
keywords = {Bivariate normal distribution, Central limit theorem, Discriminant analysis, Equal-density contours, Multivariate normal distribution, Standardized distribution, Testing for multivariate normality},
abstract = {The univariate normal distribution is defined by two parameters, mean and variance. When multiple variables are involved, we must cope with a vector of means (i.e., a centroid) rather than dealing with a single mean, and with a covariance matrix which contains variances (on the principal diagonal) and also covariances (off-diagonal) in place of a single variance. In this article, we start with a special case of the multivariate normal distribution, the bivariate normal distribution with only two variables. We define the joint, marginal, and conditional distribution by means of explanation and visualization. By slicing the bivariate normal surface horizontally, we obtain a series of concentric ellipses, which are called equal-density contours. Many cases are distinguished, with and without correlation between the two variables and with and without equal standard deviations. After discussing the properties of the multivariate normal distribution and the central limit theorem, the standardized distribution is introduced and a few examples of calculation are added. Out of the many possible applications in multivariate analysis, Hotelling’s T2-Test and Mahalanobis’ distance D2 of multiple discriminant analysis are chosen as illustrations. We conclude with a discussion of testing for multivariate normality.}
}

